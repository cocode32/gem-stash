{
	"name": "gem-stash",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"scan": "node src/cli/scan.ts",
		"process": "node src/cli/process.ts",
		"scaffold": "node src/cli/scaffold.ts",
		"tag": "node src/cli/tag.ts",
		"render": "node src/cli/render.ts",
		"restructure": "node src/cli/restructure.ts",
		"purge": "node src/cli/purge.ts",
		"sidecars:export": "node tools/sidecar-sync.ts export",
		"sidecars:restore": "node tools/sidecar-sync.ts restore",
		"sidecars:index": "node tools/sidecar-sync.ts index",
		"discogs": "node --env-file=.env tools/discogs-fetch.ts",
		"discogs-apply": "node --env-file=.env tools/discogs-to-sidecar.ts",
		"typecheck": "tsc --noEmit",
		"crosscheck": "node --env-file=.env tools/metadata-crosscheck.ts"
	},
	"dependencies": {
		"@clack/prompts": "^1.5.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^25.9.3",
		"typescript": "^6.0.3"
	}
}
